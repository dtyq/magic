{
	"name": "@dtyq/magic-admin-v2",
	"version": "0.1.0",
	"private": true,
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./upload": "./src/capabilities/upload.ts",
		"./embedded.css": "./src/styles/embedded.css",
		"./styles.css": "./src/styles/globals.css"
	},
	"scripts": {
		"build": "pnpm run build:opensource",
		"build:opensource": "tsc -p tsconfig.opensource.json && vite build",
		"dev": "pnpm run dev:opensource",
		"dev:opensource": "vite",
		"dev:opensource:https": "DEV_HTTPS_KEY=./certs/dev-key.pem DEV_HTTPS_CERT=./certs/dev-cert.pem vite --host 127.0.0.1 --port 443 --strictPort",
		"dev:opensource:https:local": "DEV_HTTPS_KEY=./certs/dev-key.pem DEV_HTTPS_CERT=./certs/dev-cert.pem vite --host 127.0.0.1 --port 5174 --strictPort",
		"dev:opensource:lan": "vite --host 0.0.0.0 --port 5174",
		"dev:opensource:local": "vite --host 127.0.0.1 --port 5174",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "pnpm test:unit",
		"test:all": "pnpm test:unit && pnpm test:components && pnpm test:integration",
		"test:components": "vitest run --config ./vitest.components.config.ts",
		"test:integration": "if [ -d tests/integration ]; then node --import tsx --test $(find \"$PWD/tests/integration\" -type f -name \"*.test.ts\" -print); else echo \"No public integration tests\"; fi",
		"test:permissions": "node --import tsx --test $(find \"$PWD/tests/unit\" -type f -iname \"*permission*.test.ts\" -print)",
		"test:unit": "node --import tsx --test $(find \"$PWD/tests/unit\" -type f -name \"*.test.ts\" -print)",
		"types": "pnpm run types:opensource",
		"types:opensource": "tsc -p tsconfig.opensource.json"
	},
	"dependencies": {
		"@dtyq/upload-sdk": "~0.0.9",
		"@hookform/resolvers": "^5.2.2",
		"@tabler/icons-react": "^3.38.0",
		"@tanstack/react-query": "^5.0.0",
		"@tanstack/react-table": "^8.21.3",
		"ahooks": "^3.7.11",
		"axios": "^1.7.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next-resources-to-backend": "^1.2.1",
		"libphonenumber-js": "^1.12.7",
		"lucide-react": "^0.577.0",
		"qrcode.react": "^3.2.0",
		"recharts": "^3.5.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"xlsx-js-style": "^1.2.0",
		"zod": "^4.1.13",
		"zustand": "^4.5.2"
	},
	"devDependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@eslint/js": "^9.0.0",
		"@radix-ui/react-alert-dialog": "1.1.16",
		"@radix-ui/react-checkbox": "1.3.4",
		"@radix-ui/react-collapsible": "1.1.13",
		"@radix-ui/react-dialog": "1.1.16",
		"@radix-ui/react-dropdown-menu": "2.1.17",
		"@radix-ui/react-select": "2.3.0",
		"@radix-ui/react-slot": "1.2.5",
		"@radix-ui/react-tabs": "1.1.14",
		"@radix-ui/react-tooltip": "1.2.9",
		"@types/node": "^22.0.0",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.4.0",
		"eslint": "^9.0.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.0",
		"globals": "^15.0.0",
		"i18next": "23.16.8",
		"postcss": "^8.4.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "7.83.0",
		"react-i18next": "14.1.3",
		"react-router": "^6.23.1",
		"react-router-dom": "^6.23.1",
		"tailwindcss": "^3.4.0",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.21.0",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.0.3"
	},
	"peerDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-checkbox": "^1.3.4",
		"@radix-ui/react-collapsible": "^1.1.13",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"i18next": "^23.11.4",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "^7.66.1",
		"react-i18next": "^14.1.1",
		"react-router": "^6.23.1",
		"react-router-dom": "^6.23.1"
	}
}
