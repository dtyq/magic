# Host the example page on this address.
WIDGET_EXAMPLE_HOST=127.0.0.1
WIDGET_EXAMPLE_PORT=4318

# Deployed magic-web origin that serves /sdk/magic-widget.js (required).
WIDGET_EXAMPLE_APP_URL=https://example-magic-web.local

# Connection config injected into the page (crewId is required).
WIDGET_EXAMPLE_CREW_ID=crew-example-fictional
WIDGET_EXAMPLE_DEPLOYMENT_CODE=deployment-example-fictional
WIDGET_EXAMPLE_ORGANIZATION_CODE=organization-example-fictional
WIDGET_EXAMPLE_LOGIN_STRATEGY=private_deployment
