VITE_API_BASE_URL=https://magic-service.example.com
VITE_TEAMSHARE_API_BASE_URL=https://teamshare-service.example.com
VITE_KEEWOOD_API_BASE_URL=https://keewood-service.example.com
VITE_KEEWOOD_WEB_URL=https://keewood-web.example.com

# Optional aliases that match legacy deployment variable semantics.
VITE_MAGIC_SERVICE_TEAMSHARE_BASE_URL=
VITE_MAGIC_SERVICE_KEEWOOD_BASE_URL=
VITE_MAGIC_KEEWOOD_WEB_URL=

VITE_DEV_AUTH_ENABLED=false
# Magic authorization. The legacy VITE_DEV_AUTH_TOKEN variables remain supported.
VITE_DEV_MAGIC_AUTH_TOKEN=
VITE_DEV_MAGIC_AUTH_TOKEN_PREFIX=
VITE_DEV_AUTH_TOKEN=
VITE_DEV_AUTH_TOKEN_PREFIX=

# Teamshare and Keewood share this authorization in Standalone mode.
VITE_DEV_TEAMSHARE_AUTH_TOKEN=
VITE_DEV_TEAMSHARE_AUTH_TOKEN_PREFIX=
VITE_DEV_MAGIC_ORGANIZATION_CODE=
VITE_DEV_TEAMSHARE_ORGANIZATION_CODE=
VITE_DEV_LANGUAGE=zh_CN

# Optional local HTTPS dev server certificate paths.
# Keep certificate files local and do not commit them.
# DEV_HTTPS_KEY=./certs/dev-key.pem
# DEV_HTTPS_CERT=./certs/dev-cert.pem
