{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"customConditions": ["magic-web-source"],
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"@/*": ["./src/*"],
			"@admin-components": ["./packages/magic-admin/components/index.ts"],
			"@admin-enterprise/*": ["./packages/magic-admin/enterprise/src/*"],
			"@admin/*": ["./packages/magic-admin/src/*"],
			"@customer/*": ["./customer/src/*"],
			"@dtyq/magic-admin": ["./packages/magic-admin/src/index.ts"],
			"@dtyq/magic-admin-v2": ["./packages/magic-admin-v2/src/index.ts"],
			"@dtyq/magic-admin/ServiceIcon": [
				"./packages/magic-admin/src/pages/PlatformPackage/components/ServiceIcon/index.tsx"
			],
			"@dtyq/magic-admin/components": ["./packages/magic-admin/components/index.ts"],
			"@dtyq/magic-admin/locales": ["./packages/magic-admin/src/locales/index.ts"],
			"@dtyq/magic-admin/provider": [
				"./packages/magic-admin/src/provider/AdminProvider/index.tsx"
			],
			"@dtyq/magic-admin/utils/tablerIconLoader": [
				"./packages/magic-admin/src/utils/tablerIconLoader.tsx"
			],
			"@dtyq/x-markdown": ["./packages/x-markdown/src/index.ts"],
			"@dtyq/x-markdown/*": ["./packages/x-markdown/src/*"],
			"@enterprise/*": ["./enterprise/src/*"],
			"@magic-admin-v2/*": ["./packages/magic-admin-v2/src/*"],
			"@magic-web/html2image": ["./packages/html2image/src/index.ts"],
			"@magic-web/html2pdf": ["./packages/html2pdf/src/index.ts"],
			"@magic/html2pptx": ["./packages/html2pptx/src/index.ts"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020",
		"typeRoots": ["./types"],
		"useDefineForClassFields": true
	},
	"exclude": [
		"dist/**/*",
		"src/pages/superMagic/components/Detail/contents/HTML/templates/**/*",
		"src/**/__tests__/**/*.ts",
		"src/**/__tests__/**/*.tsx",
		"enterprise/src/**/__tests__/**/*.ts",
		"enterprise/src/**/__tests__/**/*.tsx",
		"customer/src/**/__tests__/**/*.ts",
		"customer/src/**/__tests__/**/*.tsx"
	],
	"include": [
		"src/**/*",
		"enterprise/src/**/*",
		"customer/src/**/*",
		"types/**/*",
		"mock/**/*",
		"test",
		"vite/**/*.ts",
		"enterprise/src/Demo.tsx"
	],
	"references": [
		{
			"path": "./tsconfig.node.json"
		},
		{
			"path": "./tsconfig.test.json"
		}
	]
}
