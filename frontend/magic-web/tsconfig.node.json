{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.html-sandbox.config.ts",
		"commitlint.config.cjs",
		".eslintrc.cjs",
		".prettierrc.cjs",
		".stylelintrc.cjs",
		"./plugins/**/*.ts",
		"./vite/**/*.ts",
		"./packages/magic-admin/**/*.ts",
		"./packages/html2pptx/vite.config.ts",
		"./packages/html2pptx/vite/**/*.ts",
		"tailwind.config.js",
		"postcss.config.ts"
	]
}
