{
	"name": "@dtyq/html-sandbox",
	"version": "0.1.0",
	"private": false,
	"description": "Self-contained HTML sandbox runtime for iframe rendering, inspection, and editor bridge workflows.",
	"keywords": [
		"html",
		"iframe",
		"sandbox",
		"runtime",
		"postmessage"
	],
	"license": "Apache-2.0",
	"sideEffects": [
		"./src/auto-start.ts",
		"./dist/auto-start.js"
	],
	"type": "module",
	"exports": {
		".": {
			"magic-web-source": "./src/index.ts",
			"types": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"magic-web-source": "./src/runtime/index.ts",
			"types": "./src/runtime/index.ts",
			"import": "./dist/runtime/index.js"
		},
		"./runtime/api": {
			"magic-web-source": "./src/runtime/api/index.ts",
			"types": "./src/runtime/api/index.ts",
			"import": "./dist/runtime/api/index.js"
		},
		"./runtime/RuntimeLogger": {
			"magic-web-source": "./src/runtime/RuntimeLogger.ts",
			"types": "./src/runtime/RuntimeLogger.ts",
			"import": "./dist/runtime/RuntimeLogger.js"
		},
		"./runtime/RuntimePlugin": {
			"magic-web-source": "./src/runtime/RuntimePlugin.ts",
			"types": "./src/runtime/RuntimePlugin.ts",
			"import": "./dist/runtime/RuntimePlugin.js"
		},
		"./utils/parentOrigin": {
			"magic-web-source": "./src/utils/parentOrigin.ts",
			"types": "./src/utils/parentOrigin.ts",
			"import": "./dist/utils/parentOrigin.js"
		},
		"./utils/pptBuildRuntime": {
			"magic-web-source": "./src/utils/pptBuildRuntime.ts",
			"types": "./src/utils/pptBuildRuntime.ts",
			"import": "./dist/utils/pptBuildRuntime.js"
		},
		"./utils/pptBuild": {
			"magic-web-source": "./src/utils/pptBuild.ts",
			"types": "./src/utils/pptBuild.ts",
			"import": "./dist/utils/pptBuild.js"
		},
		"./utils/safeUrl": {
			"magic-web-source": "./src/utils/safeUrl.ts",
			"types": "./src/utils/safeUrl.ts",
			"import": "./dist/utils/safeUrl.js"
		},
		"./utils/textContent": {
			"magic-web-source": "./src/utils/textContent.ts",
			"types": "./src/utils/textContent.ts",
			"import": "./dist/utils/textContent.js"
		},
		"./utils/sourceNodes": {
			"magic-web-source": "./src/utils/sourceNodes.ts",
			"types": "./src/utils/sourceNodes.ts",
			"import": "./dist/utils/sourceNodes.js"
		},
		"./utils/inspectableTextContent": {
			"magic-web-source": "./src/utils/inspectableTextContent.ts",
			"types": "./src/utils/inspectableTextContent.ts",
			"import": "./dist/utils/inspectableTextContent.js"
		},
		"./telemetry": {
			"magic-web-source": "./src/telemetry/index.ts",
			"types": "./src/telemetry/index.ts",
			"import": "./dist/telemetry/index.js"
		},
		"./index.html": {
			"magic-web-source": "./index.html",
			"default": "./dist/index.html"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./src/index.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm run build:npm && pnpm run build:html",
		"build:html": "node scripts/build.cjs",
		"build:lib": "pnpm run build:npm",
		"build:npm": "tsc -p tsconfig.build.json",
		"dev": "node server.cjs",
		"dev:https": "sudo node server.cjs --host 127.0.0.2 --port 443",
		"prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
		"start": "node server.cjs",
		"test": "pnpm exec vitest run --config ./vitest.config.ts",
		"test:watch": "pnpm exec vitest --config ./vitest.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@zumer/snapdom": "^2.24.17"
	},
	"devDependencies": {
		"@types/node": "^22.16.4",
		"typescript": "^5.4.5",
		"vite": "^8.0.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
