{
	"name": "magic-web",
	"version": "3.0.0",
	"private": true,
	"description": "Main Magic web application built with React and Vite for enterprise and open-source editions.",
	"keywords": [
		"react",
		"vite",
		"web-application",
		"enterprise",
		"typescript",
		"ai",
		"agent",
		"super-magic"
	],
	"homepage": "https://github.com/dtyq/magic/tree/master/frontend/magic-web#readme",
	"bugs": {
		"url": "https://github.com/dtyq/magic/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dtyq/magic.git",
		"directory": "frontend/magic-web"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "node scripts/build.cjs",
		"build:admin:enterprise": "corepack pnpm --filter @dtyq/magic-admin build",
		"build:admin:opensource": "corepack pnpm --filter @dtyq/magic-admin build:opensource",
		"build:iframe": "corepack pnpm --dir packages/html-sandbox build:html -- --out-file ../../public/husky.html --runtime-out-file ../../public/husky-runtime.js",
		"build:widget": "corepack pnpm --filter @magic-web/widget-sdk exec vite build --config ./vite.config.ts --mode production --outDir ../../public/sdk && corepack pnpm --filter @magic-web/widget-sdk build:types",
		"check:overlay-sync": "node scripts/git-hooks/check-overlay-sync.cjs",
		"coverage": "vitest run --coverage",
		"dev": "node scripts/dev.cjs",
		"dev:iframe": "corepack pnpm --dir packages/html-sandbox build:html -- --out-file ../../public/husky.html --runtime-out-file ../../public/husky-runtime.js --watch",
		"dev:widget": "corepack pnpm --filter @magic-web/widget-sdk exec vite build --config ./vite.config.ts --mode development --watch --outDir ../../public/sdk",
		"generate:html-design-catalog": "python3 ../../backend/magic-service/tools/html-design-style/generate_catalog.py",
		"generate:html-design-catalog:check": "python3 ../../backend/magic-service/tools/html-design-style/generate_catalog.py --check",
		"generate:icon-tags": "node scripts/icons/gen-tabler-icon-tags.cjs",
		"generate:self-media-preset-previews": "node scripts/capture-self-media-preset-previews.mjs",
		"generate:theme-rgb-tokens": "tsx scripts/generate-theme-rgb-tokens.ts",
		"generate:theme-rgb-tokens:check": "tsx scripts/generate-theme-rgb-tokens.ts --check",
		"postinstall": "node scripts/install-overlay-deps.cjs",
		"lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint ./src --ext ts,tsx --format stylish --report-unused-disable-directives",
		"lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint ./src --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --fix && prettier --write './src/**/*.json'",
		"lint:layers": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,enterprise/src,customer/src}/**/*.{js,jsx,ts,tsx}\" --format stylish --report-unused-disable-directives --no-error-on-unmatched-pattern",
		"lint:layers:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,enterprise/src,customer/src}/**/*.{js,jsx,ts,tsx}\" --format stylish --report-unused-disable-directives --max-warnings 0 --fix --no-error-on-unmatched-pattern && prettier --write \"{src,enterprise/src,customer/src}/**/*.json\"",
		"prepare": "corepack pnpm run setup:hooks",
		"preview": "vite preview",
		"setup:hooks": "node scripts/install-git-hooks.cjs",
		"test": "vitest run --config ./vitest.config.ts",
		"test:ci": "CI=true vitest run --config ./vitest.config.ts",
		"test:html-sandbox": "node --test server/tests/html-sandbox-runtime-cors.test.cjs && pnpm test:html-sandbox:types && pnpm test:html-sandbox:unit && pnpm test:html-sandbox:browser",
		"test:html-sandbox:browser": "tsx test/html-sandbox/run-browser.ts",
		"test:html-sandbox:examples": "tsx test/html-sandbox/serve-fixtures.ts",
		"test:html-sandbox:types": "tsc --project tsconfig.iframe-runtime.json",
		"test:html-sandbox:unit": "vitest run --config ./vitest.html-sandbox.config.ts",
		"test:watch": "vitest run --config ./vitest.config.ts --watch",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"wiki": "bash .cursor/skills/wiki-generator/scripts/serve-wiki.sh"
	},
	"lint-staged": {
		"{src,enterprise/src,customer/src}/**/*.{js,jsx,ts,tsx}": [
			"eslint --fix --config .eslintrc.cjs --parser-options '{\"project\":null}'",
			"prettier --write"
		],
		"**/!(package).json": [
			"prettier --write"
		],
		"**/package.json": [
			"prettier --write",
			"sort-package-json"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all",
			"not ios_saf < 13",
			"not safari < 13"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
