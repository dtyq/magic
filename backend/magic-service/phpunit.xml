<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         backupGlobals="false"
         bootstrap="./test/bootstrap.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false" 
         failOnWarning="false">

  <!-- 环境变量配置 -->
  <php>
    <env name="APP_ENV" value="testing"/>
  </php>

  <!-- 测试套件定义 -->
  <testsuites>
    <testsuite name="大模型网关测试">
      <directory suffix="Test.php">test/Cases/Api/ModelGateway</directory>
      <file>test/Cases/Infrastructure/ExternalAPI/Search/DeepSeekSearchAdapterTest.php</file>
      <file>test/Cases/Infrastructure/ExternalAPI/Search/DeepSeekSearchTest.php</file>
      <file>test/Cases/Infrastructure/ExternalAPI/WebScrape/DeepSeekWebScrapeTest.php</file>
      <file>test/Cases/Domain/Provider/Entity/AiAbilityEntityTest.php</file>
    </testsuite>
    <testsuite name="登录测试">
      <directory suffix="Test.php">test/Cases/Api/Login</directory>
      <directory suffix="Test.php">test/Cases/Api/Contact</directory>
    </testsuite>
    <testsuite name="聊天用户API测试">
      <directory suffix="Test.php">test/Cases/Api/Chat</directory>
    </testsuite>
    <testsuite name="组件测试">
      <directory suffix="Test.php">test/Cases/Api/Kernel</directory>
      <directory suffix="Test.php">test/Cases/Application/Kernel</directory>
      <directory suffix="Test.php">test/Cases/Application/Bootstrap</directory>
    </testsuite>
    <testsuite name="权限测试">
      <directory suffix="Test.php">test/Cases/Application/Permission</directory>
      <directory suffix="Test.php">test/Cases/Permission</directory>
      <directory suffix="Test.php">test/Cases/Api/Permission</directory>
      <directory suffix="Test.php">test/Cases/Infrastructure/Util/Auth</directory>
    </testsuite>
    <testsuite name="组织测试">
      <directory suffix="Test.php">test/Cases/Domain/Organization</directory>
    </testsuite>
    <testsuite name="管理后台测试">
      <directory suffix="Test.php">test/Cases/Api/Admin</directory>
    </testsuite>
    <testsuite name="超级麦吉文件测试">
      <file>test/Cases/Application/SuperMagic/Skill/SkillPreparedPublishTest.php</file>
      <file>test/Cases/Application/SuperMagic/Skill/SkillPackageParserTest.php</file>
      <file>test/Cases/Application/SuperMagic/Project/Service/ProjectCreationTransactionTest.php</file>
      <directory suffix="Test.php">test/Cases/Domain/SuperMagic</directory>
      <directory suffix="Test.php">test/Cases/Interfaces/SuperMagic/File</directory>
      <!--
        test/Cases/Application/SuperMagic 不在任何 testsuite 里（历史遗留：该目录下
        既有的 MagicFSFileAppServicePublishedAccessTest 同样从未被执行过）。把整个目录
        收进这个 suite 会顺带改变一批与本改动无关的测试的执行状态，那是另一个决定；
        所以这里按文件精确登记新增的变更投递单测，让它们真的跑起来，同时把结构性缺口
        留在明面上。
      -->
      <file>test/Cases/Application/SuperMagic/File/Service/MagicFSChangePublisherTest.php</file>
      <file>test/Cases/Application/SuperMagic/File/Service/MagicFSFileAppServiceChangeFeedBatchTest.php</file>
      <!--
        沙箱全量重启（sandbox:restart-all）：计划生成、编排、CLI 契约。按文件精确登记，
        原因同上——整个 Application/SuperMagic 目录不在任何 suite 里。
      -->
      <file>test/Cases/Unit/SuperMagic/SandboxRestart/SandboxImageVersionTest.php</file>
      <file>test/Cases/Unit/SuperMagic/SandboxRestart/SandboxRestartPlannerTest.php</file>
      <file>test/Cases/Unit/SuperMagic/SandboxRestart/SandboxRestartAppServiceTest.php</file>
      <file>test/Cases/Unit/SuperMagic/SandboxRestart/SandboxRestartBatchRunnerTest.php</file>
      <file>test/Cases/Unit/SuperMagic/SandboxRestart/RestartAllSandboxCommandTest.php</file>
      <file>test/Cases/Domain/SuperMagic/Task/Service/AgentDomainServiceEnsureSandboxInitializedTest.php</file>
      <file>test/Cases/Domain/SuperAgent/Service/SandboxVersionDomainServiceTest.php</file>
      <file>test/Cases/Application/SuperAgent/Service/AgentAppServiceVersionCheckTest.php</file>
      <file>test/Cases/Application/SuperMagic/Agent/AgentAppServiceLifecycleTest.php</file>
      <file>test/Cases/Application/SuperMagic/Agent/ClawPermissionReconciliationSubscriberTest.php</file>
      <file>test/Cases/Interfaces/SuperMagic/Task/DTO/Request/CreateOpenTaskRequestDTOTest.php</file>
      <file>test/Cases/Application/SuperMagic/Message/Assembler/UserMessageDTOAssemblerTest.php</file>
      <file>test/Cases/Application/SuperMagic/Message/Service/HandleUserMessageDispatchTest.php</file>
      <file>test/Cases/Interfaces/SuperMagic/Task/Assembler/OpenTaskMessageAssemblerTest.php</file>
      <file>test/Cases/Application/SuperMagic/File/Service/OpenFileUploadTest.php</file>
      <file>test/Cases/Application/SuperMagic/Task/Service/TopicTaskHttpMessageTest.php</file>
      <file>test/Cases/Application/SuperMagic/Task/Service/TopicTaskAppServiceHiringTest.php</file>
      <file>test/Cases/Application/SuperMagic/Task/Service/TopicTaskAppServiceAutoHireTest.php</file>
      <file>test/Cases/Infrastructure/SuperMagic/ExternalAPI/SandboxOS/SandboxListGatewayTest.php</file>
      <file>test/Cases/Infrastructure/SuperMagic/ExternalAPI/SandboxOS/Gateway/Result/SandboxListResultTest.php</file>
    </testsuite>
  </testsuites>

  <!-- 覆盖率统计的目录配置，不是执行单测的目录 -->
  <source>
    <include>
      <directory suffix=".php">app</directory>
    </include>
  </source>

  <!-- 覆盖率配置（PHPUnit 10.x 新结构）

  <coverage enabled="false" includeUncoveredFiles="false"
            pathCoverage="false"
            ignoreDeprecatedCodeUnits="true"
            disableCodeCoverageIgnore="true">
    <report>
      <text outputFile="coverage/text.txt" showUncoveredFiles="false"/>
      <cobertura outputFile="coverage/cobertura.xml"/>
      <clover outputFile="coverage/clover.xml"/>
      <html outputDirectory="coverage/html" lowUpperBound="35" highLowerBound="70"/>
    </report>
  </coverage> -->

  <!-- 日志配置 -->
  <logging>
    <junit outputFile="coverage/junit.xml"/>
    <teamcity outputFile="coverage/teamcity.txt"/>
    <testdoxHtml outputFile="coverage/testdox.html"/>
    <testdoxText outputFile="coverage/testdox.txt"/>
  </logging>

  <!-- 扩展配置（需要兼容 PHPUnit 10） -->
  <extensions>
    <bootstrap class="HyperfTest\Extensions\Runners\SlowestTests\Extension">
      <parameter name="maxTests" value="100"/>  <!-- 最大收集数量 -->
      <parameter name="minDuration" value="1000"/> <!-- 最小耗时（毫秒） -->
    </bootstrap>
  </extensions>
</phpunit>
