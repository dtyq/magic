{
	"name": "@magic-web/html2image",
	"version": "0.1.0",
	"private": false,
	"description": "Browser-based HTML to image export utilities",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm exec vite build --config ./vite.config.ts --mode production && pnpm run build:types",
		"build:types": "tsc -p ./tsconfig.build.json --emitDeclarationOnly",
		"dev": "pnpm exec vite --config ./vite.config.ts",
		"prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
		"preview": "pnpm exec vite preview --config ./vite.config.ts --mode production",
		"test": "pnpm exec vitest run --config ./vitest.config.ts",
		"test:watch": "pnpm exec vitest --config ./vitest.config.ts",
		"typecheck": "tsc -p ./tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.13.10",
		"@zumer/snapdom": "^2.24.17",
		"jszip": "^3.10.1",
		"typescript": "^5.4.5",
		"vite": "^8.0.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@zumer/snapdom": "^2.24.17",
		"jszip": "^3.10.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
